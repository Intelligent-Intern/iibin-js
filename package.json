{
  "name": "@intelligentintern/iibin",
  "version": "2.0.0-alpha.1",
  "description": "Schema-defined IIBIN binary messages for browsers and Node.js",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.js",
      "require": "./dist/legacy.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsup src/index.ts src/legacy.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Intelligent-Intern/iibin-js.git"
  },
  "bugs": {
    "url": "https://github.com/Intelligent-Intern/iibin-js/issues"
  },
  "homepage": "https://github.com/Intelligent-Intern/iibin-js",
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
